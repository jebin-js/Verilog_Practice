    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x61921e79ecf0_0;
    %pad/u 32;
    %cmpi/e 1010, 0, 32;
    %jmp/0xz  T_0.2, 4;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v0x61921e79ecf0_0, 0;
    %jmp T_0.3;
T_0.2 ;
    %load/vec4 v0x61921e79ecf0_0;
    %addi 1, 0, 4;
    %store/vec4 v0x61921e79ecf0_0, 0, 4;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x61921e78a550;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x61921e79eef0_0, 0, 1;
    %end;
    .thread T_1;
    .scope S_0x61921e78a550;
T_2 ;
    %delay 5, 0;
    %load/vec4 v0x61921e79eef0_0;
    %inv;
    %store/vec4 v0x61921e79eef0_0, 0, 1;
    %jmp T_2;
