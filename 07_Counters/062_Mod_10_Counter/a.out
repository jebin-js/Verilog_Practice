v0x61921e77a0e0_0 .net "clk", 0 0, v0x61921e79eef0_0;  1 drivers
v0x61921e79ecf0_0 .var "count", 3 0;
v0x61921e79edd0_0 .net "rst", 0 0, v0x61921e79f090_0;  1 drivers
