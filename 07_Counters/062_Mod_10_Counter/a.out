S_0x61921e78a6e0 .scope module, "DUT" "mod10_counter" 2 8, 3 1 0, S_0x61921e78a550;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
